# ------------------------------------------------------------------
# Einstellungen der Entwicklungs-Sandbox
# Diese Datei nach .env kopieren und anpassen.
# ------------------------------------------------------------------

# --- Identitaet -----------------------------------------------------
SANDBOX_NAME=sandbox
SANDBOX_IMAGE=sandbox-opencode:local
TZ=Europe/Berlin

# --- Anthropic / Claude ---------------------------------------------
# Variante A: API-Key aus der Anthropic Console (console.anthropic.com)
# Variante B: leer lassen und im Container "opencode" starten, dort /connect
ANTHROPIC_API_KEY=

# --- Projekte --------------------------------------------------------
# Verzeichnis auf dem Mac, das im Container unter /work erscheint.
# Relativ zu dieser Datei oder absoluter Pfad
WORKSPACE_DIR=./workspace

# --- Git im Container -------------------------------------------------
GIT_USER_NAME=
GIT_USER_EMAIL=

# --- GitHub -----------------------------------------------------------
# Persoenliches Zugriffstoken. Wird fuer die GitHub CLI (Checkout, Push,
# Pull Requests), fuer git ueber HTTPS und fuer den MCP-Server verwendet.
#   Classic Token:      Scopes  repo, read:org, project
#   Fine-grained Token: Repository-Rechte Contents/Issues/Pull requests (RW)
#                       plus Organization-Recht "Projects" (RW)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Welche Werkzeuggruppen der MCP-Server anbietet.
# "projects" wird fuer das Project-Board gebraucht, "all" schaltet alles frei.
GITHUB_TOOLSETS=context,repos,issues,pull_requests,labels,projects

# Auf 1 setzen, wenn der MCP-Server nur lesen darf
GITHUB_READ_ONLY=

# GitHub Enterprise: Hostname, sonst leer lassen
GH_HOST=github.com

# Version des GitHub-MCP-Servers, z. B. v0.20.0 (latest = neueste)
GITHUB_MCP_VERSION=latest

# --- Project-Board: Vorgaben fuer /plan-item und /implement-item ------
# Owner ist die Organisation oder der Nutzer, dem das Board gehoert.
# Die Nummer steht in der Board-URL: github.com/orgs/<owner>/projects/<nr>
GITHUB_PROJECT_OWNER=
GITHUB_PROJECT_NUMBER=
GITHUB_PROJECT_STATUS_FIELD=Status
GITHUB_STATUS_PLANNED="Ready"
GITHUB_STATUS_IN_PROGRESS="In Progress"
GITHUB_STATUS_IN_REVIEW="In Review"
GIT_DEFAULT_BRANCH=main

# --- Toolchains (werden beim Bauen des Images beruecksichtigt) --------
INSTALL_GO=true
# GO_VERSION leer lassen = jeweils aktuelle Go-Version, sonst z. B. 1.23.4
GO_VERSION=
INSTALL_NODE=true
NODE_MAJOR=22
INSTALL_PYTHON=true
INSTALL_RUST=false
INSTALL_DOTNET=false
# DOTNET_VERSION leer lassen = neueste stabile Version, sonst z. B. 10.0.402
DOTNET_VERSION=
ENABLE_SUDO=true
# Zusaetzliche Debian-Pakete, durch Leerzeichen getrennt
EXTRA_APT_PACKAGES=

# --- Agenten im Container ---------------------------------------------
# Jeder laesst sich einzeln abschalten. Versionsfelder leer = neueste.
INSTALL_OPENCODE=true
OPENCODE_VERSION=
INSTALL_CLAUDE=true
CLAUDE_CODE_VERSION=

# Die CLIs liegen in /usr/local und duerfen sich nicht selbst aktualisieren
DISABLE_AUTOUPDATER=1

# Was ./sandbox.sh ohne Argument macht: shell | opencode | claude
DEFAULT_ENTRY=shell

# Vorlage aus config/claude bei jedem Start ueberschreiben
# (1) oder nur anlegen, wenn im Container noch nichts liegt (0).
# Einmalig nachziehen geht auch mit: ./sandbox.sh reseed
SEED_OVERWRITE=0

# --- Ressourcen -------------------------------------------------------
SANDBOX_CPUS=4
SANDBOX_MEMORY=6g

# --- Portweiterleitungen (nur lokal erreichbar) -----------------------
PORT_A=127.0.0.1:3000
PORT_B=127.0.0.1:5173
PORT_C=127.0.0.1:8000

# --- Benutzer im Container (i. d. R. unveraendert lassen) -------------
SANDBOX_UID=1000
SANDBOX_GID=1000
