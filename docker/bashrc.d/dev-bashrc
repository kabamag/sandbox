# Sandbox-Basiskonfiguration fuer interaktive bash-Shells
# (wird bei Nicht-Login-Shells geladen, im Gegensatz zu /etc/profile.d/*)

# Sandbox-Prompt und Aliase laden (aus /etc/profile.d, falls vorhanden)
if [ -f /etc/profile.d/zz-sandbox.sh ]; then
  . /etc/profile.d/zz-sandbox.sh
fi

export PS1='\[\e]0;\u@\h: \w\a\]\[\033[01;32m\]sandbox\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

# Komfort
alias ll='ls -alF --color=auto'
alias ls='ls --color=auto'
