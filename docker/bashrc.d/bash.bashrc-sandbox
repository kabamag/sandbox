# Sandbox-Prompt fuer interaktive Bash-Shells (Login und Non-Login).
# Wird von /etc/bash.bashrc bei Debian-basierten Images geladen.
# Überschreibt den Debian-Default-Prompt (siehe /etc/bash.bashrc Zeile ~21).
export PS1='\[\e]0;\u@\h: \w\a\]\[\033[01;32m\]sandbox\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '

# Farbe fuer ls/grep aktivieren
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto' 2>/dev/null || true
    alias grep='grep --color=auto' 2>/dev/null || true
fi
